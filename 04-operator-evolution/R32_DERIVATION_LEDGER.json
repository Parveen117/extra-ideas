  "claims": [
    {
      "id": "R32.1",
      "title": "Reciprocal edges can retain a loop that no common native frame flattens",
      "written_section_sha256": "a7f16a3c9ec88631b2394ccbf95e27889d175193f7cd8c39bd49ebc9f1d7a3eb",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
      "exact_check_groups": [
        "native_source_law_record_has_a_nonflat_reciprocal_loop",
        "native_gap_obstructs_flat_transport_similarity_and_local_frame_removal"
      ],
      "scope_boundary": "The reciprocal source-law record has loop -I and no common frame can flatten both directions. This is record-link curvature, distinct from a loop of the complete source transport. Periodic flattening additionally requires trivial winding."
    },
    {
      "id": "R32.2",
      "title": "Original source events construct the reciprocal retained transport",
      "written_section_sha256": "1ba1fde7d7a408734e85c545c2a7e4ad54283466fac1d81e4b7af813fde19c7e",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
      "exact_check_groups": [
        "literal_fine_source_histories_reproduce_coarse_retained_transport",
        "native_source_law_record_has_a_nonflat_reciprocal_loop",
        "retained_interaction_has_finite_native_propagation_range"
      ],
      "scope_boundary": "The original signed H/K event census and reciprocal records on native fine edges produce the coarse transport exactly. The coarse interface is a constructed target; it is not selected as a physical force or literal copying of source letter tags."
    },
    {
      "id": "R32.3",
      "title": "Native area parity changes source response while retaining record information",
      "written_section_sha256": "b1a153d19724fb786640eb4a2ff2f009353771703cca9613933de028fc3437c2",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
      "exact_check_groups": [
        "area_parity_normal_form_changes_an_actual_source_reading"
      ],
      "scope_boundary": "A native endpoint frame factors record multiplicity while leaving staggered source signs and the nonflat loop. Memory-preparation independence is restricted to one-origin product inputs on the unwrapped plane. A source response changes from 9/64 to 1/64; the record is not erased."
    },
    {
      "id": "R32.4",
      "title": "The retained source derives an exact gapped paired wave",
      "written_section_sha256": "48b2babd44d411d5f04eead65fcbbdfa3d4ec739d13125deb759dc7b67f61e26",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
      "exact_check_groups": [
        "retained_loop_derives_a_gapped_paired_wave_and_sharp_bounds"
      ],
      "scope_boundary": "Complete Laurent identities derive the paired wave and a positive identity/difference-square ledger with sharp normalized bounds one and four. This fixed-protocol increment gap is not a physical Hamiltonian mass gap or a Yang-Mills result."
    },
    {
      "id": "R32.5",
      "title": "Flat continuation is obstructed and uniform signed states have a fixed count cycle",
      "written_section_sha256": "f217020f2c9bb969ff25f74308e575cab193a2606805dc11749ff995e2b3eda6",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
      "exact_check_groups": [
        "native_gap_obstructs_flat_transport_similarity_and_local_frame_removal",
        "uniform_native_source_has_an_exact_twelve_block_cycle"
      ],
      "scope_boundary": "Finite cyclic similarity to flat continuation is excluded; on the unwrapped completion the excluded class is bounded, boundedly invertible, time-independent linear similarities. Staggered factorization and arbitrary event-dependent frame changes are not excluded. The uniform 48-event cycle concerns fully signed states, not every intensity readout."
    },
    {
      "id": "R32.6",
      "title": "The full retained increment is a complete observer with a uniform decoder bound",
      "written_section_sha256": "45e309c0ba9317e9a773669e04c7b20cf79784c20b2429bf80ccce2699efb710",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
      "exact_check_groups": [
        "signed_retained_increment_has_an_exact_inverse_and_uniform_decoder_error"
      ],
      "scope_boundary": "The complete four-role source/record signed increment is invertible, with no uniform kernel. The finite decoder has a source-independent certified error estimate. Unresolved source intensities or one scalar sensor are not claimed complete."
    },
    {
      "id": "R32.7",
      "title": "The inverse response has a source-derived localized count kernel",
      "written_section_sha256": "13f8a3ec4b0fb45d202b20d1a6dec8ade22e63fdbc49e45b081036e90919af37",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
      "exact_check_groups": [
        "native_inverse_kernel_has_a_derived_exponential_count_tail"
      ],
      "scope_boundary": "The decaying native root 3-2 sqrt(2) determines a normalized localized inverse count kernel. Positive root selection, native completion and periodic wrapping remain explicit. This target coefficient is not alpha or a selected universal physical coupling."
    }
