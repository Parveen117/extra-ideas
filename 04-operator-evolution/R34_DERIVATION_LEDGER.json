  "claims": [
    {
      "id": "R34.1",
      "title": "Native pairing derives the target burden and its minimum decoder",
      "written_section_sha256": "260e5403cc942a854fc7d2f3b468d0f8ee2b0dd488af03e66f4bcb6ef8b3311d",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
      "exact_check_groups": [
        "native_minimum_decoder_is_attained_and_orthogonal"
      ],
      "scope_boundary": "Beta is relative to a specified observer, target and native output pairing. The minimum decoder is derived for an explicit coefficient target and a gapped native Gram with inverse; no classical representation theorem is imported."
    },
    {
      "id": "R34.2",
      "title": "The current increment has burden one globally and one half locally",
      "written_section_sha256": "f2f460c39a887bd97eba4033de9ad3c289599e10baed807248bec938c260f89a",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
      "exact_check_groups": [
        "native_minimum_decoder_is_attained_and_orthogonal",
        "finite_native_component_cuts_preserve_their_boundary_beta"
      ],
      "scope_boundary": "The unwrapped full-state target has beta one and a unit local-role target beta one half. Finite cyclic local burdens use their own wrapped coefficients. These are not the R33 interaction-memory coefficient or a repository-wide proof-progress fraction."
    },
    {
      "id": "R34.3",
      "title": "Balanced native increments uniquely minimize the two-horizon worst burden",
      "written_section_sha256": "db0cb69563ac2de6fd6c3dba96713beb558f3f15c6682a0d6a7f97a570c40866",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
      "exact_check_groups": [
        "native_two_horizon_gram_has_complete_positive_identities",
        "native_two_horizon_design_has_a_unique_balanced_optimum",
        "native_sharp_patterns_certify_gain_independent_conditioning"
      ],
      "scope_boundary": "Equal native branch weights uniquely minimize worst full-state beta in the two-increment family with total squared weight one. The sharp value is one half. This is a constructed observer optimization, not a globally optimal physical sensor or a physical noise law."
    },
    {
      "id": "R34.4",
      "title": "Native path counts certify the improved local burden",
      "written_section_sha256": "a8224d74baf0d4dee5fbc0ce4bb85899a2ac04b1517b73b1cc15dc18e1f79c99",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
      "exact_check_groups": [
        "native_return_counts_certify_the_completed_local_burden",
        "finite_native_component_cuts_preserve_their_boundary_beta"
      ],
      "scope_boundary": "Finite native return counts enclose the completed unit local burden near 0.36163703165179, with a derived geometric tail. The balanced design was optimized for the full-state objective, not asserted optimal for the point objective."
    },
    {
      "id": "R34.5",
      "title": "Gain and event-cost audits separate a real design change from rescaling",
      "written_section_sha256": "1b1f96bf3ff3d3c388e568cd3d64733fd27b3d6dba475142060acb952b94a1a0",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
      "exact_check_groups": [
        "native_sharp_patterns_certify_gain_independent_conditioning",
        "native_cost_normalization_retains_its_distinct_tradeoffs"
      ],
      "scope_boundary": "The sharp response range improves from [1,4] to [2,25/8] and is not merely amplified. Weighted event-cost normalization gives full beta 3/4 but removes the local advantage; maximum-horizon normalization gives full beta one. Costs remain explicit targets."
    },
    {
      "id": "R34.6",
      "title": "The improved bank preserves the information and exposes inherited errors",
      "written_section_sha256": "b290bd2f89f63e957c58b0fd8934d21dc6208a35e4e79cfd9ce3cafa8d7ed9d3",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
      "exact_check_groups": [
        "native_error_transport_does_not_create_independent_information",
        "native_target_and_duplicate_normalization_prevent_fake_beta_reduction"
      ],
      "scope_boundary": "The new bank factors through the complete old observer and has the same kernel. Postprocessed errors share their old carrier and do not become independent; in the transported old norm beta is unchanged. Gain, duplicate and target rescaling controls explain the cited finite quarter without importing its Hilbert premise."
    }
  ],
