      ],
      "scope_boundary": "Source-derived local operator N relates the explicit event/address difference readouts. The fixed global norm ratio is typed to their normalization, not a physical impedance or coupling."
    },
    {
      "id": "R29.2",
      "title": "The two native fields obey closed reversible induction equations",
      "written_section_sha256": "2b9c4dd820ac3f8d10990a117a7349945fe2a08245cd34d28675123eda11c60a",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
