      ],
      "scope_boundary": "Exact closed reversible evolution derived on the source fields, then extended explicitly to all finite pairs. This extension is larger than the actual source image and has no external forcing premise."
    },
    {
      "id": "R29.3",
      "title": "A conserved compatibility residue selects the native source sector",
      "written_section_sha256": "26e3d55333e812cb46bb992abe074c145a89848251778e092dbf625c33ec22d5",
      "evidence": "WRITTEN_NATIVE_PROOF_WITH_SCOPED_EXACT_CHECKS",
